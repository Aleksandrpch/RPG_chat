async def tool_save_event(chat_id: str, description: str, cause_event_id: str = None) -> dict:
    try:
        # 1. Получаем character_id (так как в таблице world_events он обязателен)
        chat = await get_chat(chat_id)
        
        # 2. Создаем объект события
        event = WorldEvent(
            chat_id=chat_id,
            character_id=chat.character_id,
            event_type="action", # Можно оставить так, или LLM может это определять
            summary=description,
            data={}
        )

        # 3. Сохраняем в Postgres и получаем ID
        event_id = await add_event(event, cause_event_id=cause_event_id)
        
        return {
            "status": "success",
            "event_id": event_id,
            "message": "Событие успешно сохранено в память мира."
        }
    except Exception as e:
        logger.error(f"Ошибка при сохранении события: {e}")
        return {
            "status": "error",
            "message": f"Не удалось сохранить событие: {str(e)}"
        }