from uuid import uuid4

from app.services.world_generator import WorldGenerator
from app.database import postgresdatabase


class WorldService:
    """
    Отвечает за создание и изменение skeleton мира.

    WorldService не содержит SQL и не занимается
    непосредственной генерацией текста LLM.
    """

    def __init__(self):
        self.world_generator = WorldGenerator()

    async def create_world(self, character_data: dict) -> dict:
        """
        Создаёт новый skelet мира.

        1. Генерирует skeleton через WorldGenerator.
        2. Создаёт UUID skeleton.
        3. Сохраняет skeleton в PostgreSQL.
        4. Возвращает данные созданного skeleton.
        """

        skeleton_id = str(uuid4())

        skelet = await self.world_generator(character_data)

        await postgresdatabase.save_skeleton(
            skeleton_id=skeleton_id,
            skelet=skelet,
        )

        return {
            "skeleton_id": skeleton_id,
            "skelet": skelet,
        }